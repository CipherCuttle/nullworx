+  --ink: #090a08;
+  --ink-raised: #10110e;
+  --ink-panel: #141510;
+  --paper: #f1eddf;
+  --paper-soft: #d8d3c3;
+  --paper-dim: #9b988b;
+  --muted: #8d8a7f;
+  --line: rgb(241 237 223 / 0.14);
+  --line-strong: rgb(241 237 223 / 0.28);
+  --acid: #d8ff4a;
+  --acid-deep: #a7c835;
+  --ember: #ff5e38;
+  --font-sans: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, sans-serif;
+  --font-display: "Instrument Serif", "Iowan Old Style", Georgia, serif;
+  --font-mono: "Space Mono", "DejaVu Sans Mono", ui-monospace, monospace;
+  --page-max: 1480px;
+  --gutter: clamp(18px, 4.2vw, 68px);
+  --header-height: 76px;
+  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
+  color-scheme: dark;
+}
+
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+html {
+  min-width: 320px;
+  scroll-behavior: smooth;
+  background: var(--ink);
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+  min-height: 100vh;
+  overflow-x: clip;
+  color: var(--paper);
+  background:
+    radial-gradient(90rem 45rem at 86% -8%, rgb(216 255 74 / 0.065), transparent 62%),
+    radial-gradient(60rem 40rem at -10% 24%, rgb(255 94 56 / 0.035), transparent 60%),
+    var(--ink);
+  font-family: var(--font-sans);
+  font-size: 16px;
+  line-height: 1.55;
+  font-synthesis: none;
+  text-rendering: optimizeLegibility;
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+}
+
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: 1000;
+  opacity: 0.035;
+  pointer-events: none;
+  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
+}
+
+::selection {
+  color: var(--ink);
+  background: var(--acid);
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+button,
+input,
+textarea,
+select {
+  color: inherit;
+  font: inherit;
+}
+
+button {
+  cursor: pointer;
+}
+
+svg {
+  display: block;
+}
+
+img,
+canvas,
+video {
+  max-width: 100%;
+}
+
+p,
+h1,
+h2,
+h3,
+h4,
+figure {
+  margin: 0;
+}
+
+ul,
+ol {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+:focus-visible {
+  outline: 2px solid var(--acid);
+  outline-offset: 4px;
+}
+
+:target {
+  scroll-margin-top: calc(var(--header-height) + 24px);
+}
+
+.skip-link {
+  position: fixed;
+  top: 12px;
+  left: 12px;
+  z-index: 2000;
+  padding: 12px 16px;
+  color: var(--ink);
+  background: var(--acid);
+  font-family: var(--font-mono);
+  font-size: 12px;
+  transform: translateY(-150%);
+  transition: transform 160ms ease;
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.container {
+  width: min(100%, var(--page-max));
+  margin-inline: auto;
+  padding-inline: var(--gutter);
+}
+
+.section {
+  padding-block: clamp(72px, 9vw, 136px);
+}
+
+.mono {
+  font-family: var(--font-mono);
+  font-size: 10px;
+  line-height: 1.6;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.eyebrow {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  color: var(--paper-dim);
+  font-family: var(--font-mono);
+  font-size: 10px;
+  line-height: 1.5;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.eyebrow::before {
+  content: "";
+  width: 7px;
+  height: 7px;
+  flex: 0 0 auto;
+  background: var(--acid);
+}
+
+.display {
+  font-family: var(--font-display);
+  font-weight: 400;
+  letter-spacing: -0.035em;
+  line-height: 0.92;
+}
+
+.display em {
+  color: var(--acid);
+  font-style: italic;
+}
+
+.rule {
+  height: 1px;
+  border: 0;
+  background: var(--line);
+}
+
+.button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  min-height: 50px;
+  padding: 0 19px;
+  border: 1px solid var(--acid);
+  border-radius: 2px;
+  color: var(--ink);
+  background: var(--acid);
+  font-family: var(--font-mono);
+  font-size: 10px;
+  line-height: 1;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  transition:
+    color 180ms var(--ease),
+    background 180ms var(--ease),
+    border-color 180ms var(--ease);
+}
+
+.button .arrow {
+  font-size: 15px;
+  transition: transform 220ms var(--ease);
+}
+
+.button:hover {
+  color: var(--paper);
+  background: transparent;
+  border-color: var(--acid);
+}
+
+.button:hover .arrow {
+  transform: translate(3px, -2px);
+}
+
+.button--ghost {
+  color: var(--paper);
+  background: transparent;
+  border-color: var(--line-strong);
+}
+
+.button--ghost:hover {
+  color: var(--acid);
+  border-color: var(--acid);
+}
+
+.button--small {
+  min-height: 40px;
+  padding-inline: 14px;
+  font-size: 9px;
+  gap: 18px;
+}
+
+.text-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  padding-bottom: 5px;
+  border-bottom: 1px solid var(--line-strong);
+  color: var(--paper-soft);
+  font-family: var(--font-mono);
+  font-size: 10px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  transition:
+    color 160ms ease,
+    border-color 160ms ease;
+}
+
+.text-link:hover {
+  color: var(--acid);
+  border-color: var(--acid);
+}
+
+.tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 25px;
+  padding: 0 8px;
+  border: 1px solid var(--line);
+  border-radius: 2px;
+  color: var(--paper-soft);
+  font-family: var(--font-mono);
+  font-size: 9px;
+  line-height: 1;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.tag--acid {
+  color: var(--acid);
+  border-color: rgb(216 255 74 / 0.4);
+}
+
+.status-dot {
+  width: 6px;
+  height: 6px;
+  flex: 0 0 auto;
+  border-radius: 50%;
+  background: var(--acid);
+  box-shadow: 0 0 0 4px rgb(216 255 74 / 0.08);
+}
+
+.status-dot--muted {
+  background: var(--muted);
+  box-shadow: none;
+}
+
+.prose {
+  width: min(100%, 760px);
+}
+
+.prose > * + * {
+  margin-top: 1.3em;
+}
+
+.prose h2 {
+  margin-top: 2.8em;
+  color: var(--paper);
+  font-family: var(--font-display);
+  font-size: clamp(34px, 4vw, 52px);
+  font-weight: 400;
+  letter-spacing: -0.03em;
+  line-height: 1;
+}
+
+.prose h3 {
+  margin-top: 2.4em;
+  color: var(--paper);
+  font-size: 15px;
+  font-weight: 600;
+  letter-spacing: 0.01em;
+}
+
+.prose p,
+.prose li {
+  color: var(--paper-soft);
+  font-size: 15px;
+  line-height: 1.8;
+}
+
+.prose ul {
+  display: grid;
+  gap: 9px;
+  padding-left: 18px;
+  list-style: square;
+}
+
+.prose ul li::marker {
+  color: var(--acid);
+  font-size: 0.7em;
+}
+
+.prose a {
+  color: var(--acid);
+  text-decoration: underline;
+  text-decoration-thickness: 1px;
+  text-underline-offset: 4px;
+}
+
+.prose strong {
+  color: var(--paper);
+  font-weight: 500;
+}
+
+.prose code {
+  padding: 2px 5px;
+  color: var(--acid);
+  background: rgb(216 255 74 / 0.07);
+  font-family: var(--font-mono);
+  font-size: 0.86em;
+}
+
+.prose hr {
+  margin-block: 2.8em;
+  border: 0;
+  border-top: 1px solid var(--line);
+}
+
+.prose blockquote {
+  margin: 2em 0;
+  padding: 18px 22px;
+  border-left: 2px solid var(--acid);
+  color: var(--paper-soft);
+  background: var(--ink-raised);
+}
+
+.prose blockquote p {
+  color: inherit;
+}
+
+.page-intro {
+  padding-top: clamp(76px, 10vw, 140px);
+  padding-bottom: clamp(56px, 7vw, 96px);
+  border-bottom: 1px solid var(--line);
+}
+
+.page-intro__meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: clamp(42px, 6vw, 82px);
+}
+
+.page-intro h1 {
+  max-width: 1000px;
+  font-size: clamp(54px, 9vw, 138px);
+}
+
+.page-intro__lede {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);
+  gap: clamp(24px, 5vw, 72px);
+  align-items: end;
+  margin-top: 36px;
+}
+
+.page-intro__lede p {
+  max-width: 480px;
+  color: var(--paper-soft);
+  font-size: clamp(16px, 1.4vw, 19px);
+  line-height: 1.65;
+}
+
+.page-intro__aside {
+  justify-self: end;
+  color: var(--paper-dim);
+}
+
+@media (max-width: 760px) {
+  :root {
+    --header-height: 64px;
+  }
+
+  .page-intro__meta {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 18px;
+    margin-bottom: 42px;
+  }
+
+  .page-intro__lede {
+    grid-template-columns: 1fr;
+    align-items: start;
+  }
+
+  .page-intro__aside {
+    justify-self: start;
+  }
+
+  .button {
+    min-height: 48px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    scroll-behavior: auto !important;
+    transition-duration: 0.01ms !important;
+  }
+}
