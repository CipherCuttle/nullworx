+
+.motionControl,
+.motionState {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 3px 7px;
+  border: 1px solid var(--line);
+  color: var(--paper-dim);
+  background: transparent;
+  font-family: var(--font-mono);
+  font-size: 7px;
+  line-height: 1.4;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.motionControl:hover {
+  color: var(--acid);
+  border-color: var(--acid);
+}
+
+
+
+.motionState {
+  color: var(--muted);
+  border-color: transparent;
+}
+
+.readout[data-phase="blocked"],
+.readout[data-phase="error"] {
+  color: var(--paper);
+}
+
+.readout[data-phase="blocked"] .liveDot,
+.readout[data-phase="error"] .liveDot {
+  background: var(--ember);
+  box-shadow: 0 0 0 4px rgb(255 94 56 / 0.12);
+}
+
+.readout[data-phase="paused"] .liveDot,
+.readout[data-phase="reduced"] .liveDot,
+.readout[data-phase="hidden"] .liveDot,
+.readout[data-phase="offscreen"] .liveDot,
+.readout[data-phase="loading"] .liveDot {
+  background: var(--paper-dim);
+  box-shadow: 0 0 0 4px rgb(241 237 223 / 0.08);
+}
+
+.startOverlay {
+  position: absolute;
+  z-index: 7;
+  left: 50%;
+  bottom: 42px;
+  display: grid;
+  gap: 4px;
+  width: min(320px, calc(100% - 44px));
+  padding: 13px 15px;
+  border: 1px solid var(--acid);
+  color: var(--ink);
+  background: var(--acid);
+  text-align: left;
+  transform: translateX(-50%);
+}
+
+.startOverlay strong {
+  font-family: var(--font-mono);
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.startOverlay small {
+  color: rgb(9 10 8 / 0.72);
+  font-family: var(--font-mono);
+  font-size: 8px;
+  line-height: 1.55;
+}
+
+.startOverlay:hover {
+  color: var(--paper);
+  background: var(--ink);
+}
+
+.startOverlay:hover small {
+  color: var(--paper-dim);
+}
+
+.fallbackNote {
+  position: absolute;
+  z-index: 7;
+  left: 27px;
+  right: 27px;
+  bottom: 44px;
+  display: grid;
+  gap: 3px;
+  padding: 10px 12px;
+  border: 1px solid var(--line-strong);
+  color: var(--paper);
+  background: rgb(9 10 8 / 0.82);
+  font-family: var(--font-mono);
+}
+
+.fallbackNote strong {
+  font-size: 8px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.fallbackNote small {
+  color: var(--paper-dim);
+  font-size: 8px;
+  line-height: 1.5;
+}
+
+.reducedNote {
+  position: absolute;
+  z-index: 7;
+  left: 27px;
+  right: 27px;
+  bottom: 42px;
+  color: var(--paper-dim);
+  font-family: var(--font-mono);
+  font-size: 8px;
+  line-height: 1.5;
+  letter-spacing: 0.02em;
+}
+
+.footerLinks {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 16px;
+}
+
+@media (max-width: 760px) {
+  .motionState {
+    display: none;
+  }
+
+  .startOverlay,
+  .fallbackNote,
+  .reducedNote {
+    bottom: 38px;
+  }
+
+  .reducedNote {
+    left: 20px;
+    right: 20px;
+    font-size: 7px;
+  }
+
+  .footerLinks {
+    gap: 12px;
+  }
+}
