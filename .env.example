# ---------------------------------------------------------------------------
# Nullworx V0.1 configuration
# Copy to .env.local for local work. Never commit real credentials.
# ---------------------------------------------------------------------------

# Canonical origin. The owner-supplied target uses three l's. Confirm ownership
# before deployment.
NEXT_PUBLIC_SITE_URL=https://nulllworx.site

# Newsletter: "disabled" (default), "mock" (local preview only), or "brevo".
NEWSLETTER_PROVIDER=disabled

# Required only for NEWSLETTER_PROVIDER=mock in a production build. Mock mode
# never sends email or collects real data. Do not enable on the public site.
# NEWSLETTER_ALLOW_MOCK=1
# NEWSLETTER_MOCK_SECRET=replace-with-a-long-random-local-only-value

# Brevo (server-only). Create these values in the Brevo account. Never prefix
# any of them with NEXT_PUBLIC_. The redirect must match this exact canonical
# path; a different host, path, query or fragment disables collection.
# BREVO_API_KEY=
# BREVO_DROPS_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# NEWSLETTER_CONFIRM_REDIRECT_URL=https://nulllworx.site/drops/confirmed

# Secret used to hash IP addresses for rate limiting. Required for Brevo mode
# in a production build: at least 32 characters. Generate with
# `openssl rand -hex 32`. The raw IP is never logged by application code.
# NEWSLETTER_IP_HASH_SECRET=

# Optional. Only a verified Buy Me a Coffee URL is rendered.
# NEXT_PUBLIC_SUPPORT_URL=

# First-party, cookieless events. Set to "off" to disable the client sender.
NEXT_PUBLIC_ANALYTICS=on
