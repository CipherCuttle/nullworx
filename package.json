{
  "name": "nullworx",
  "version": "0.1.0",
  "private": true,
  "description": "Nullworx integration foundation: UI Forge v0.1, an experimental HoloType lab, and pinned Paper Shaders / Motion adapters.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "registry:build": "shadcn build && node scripts/registry.mjs --sync",
    "typecheck": "tsc --noEmit",
    "registry:validate": "node scripts/registry.mjs",
    "verify:contract": "tsx scripts/effect-contract.ts",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "verify:effects": "node scripts/verify-effects.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.82",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "motion": "14.7.1",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.5.28",
    "playwright-core": "1.64.1",
    "shadcn": "^3.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "4.23.15",
    "typescript": "^5.9.2"
  }
}
