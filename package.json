{
  "name": "nullworx",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental library of procedural visual effects for the web.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "pnpm validate:effects && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:effects": "tsx scripts/validate-effects.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "drafts": "tsx scripts/draft-release.ts",
    "provenance": "node scripts/source-provenance.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm validate:effects && pnpm test && pnpm build && pnpm check:secrets",
    "bundle:effects": "tsx scripts/build-effect-bundles.ts",
    "verify:home": "node scripts/verify-home.mjs",
    "verify:labs": "node scripts/verify-labs.mjs",
    "verify:consolidation": "node scripts/verify-home.mjs && node scripts/verify-labs.mjs",
    "capture:media": "node scripts/capture-media.mjs",
    "preservation": "node scripts/source-preservation.mjs --output evidence/g0/source-preservation-final.json"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@paper-design/shaders-react": "0.0.82",
    "motion": "14.7.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
